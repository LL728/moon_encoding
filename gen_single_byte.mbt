// Encoding names wired by this build (same source as the dispatch below).

///|
let single_byte_names : Array[String] = [
  "IBM866", "ISO-8859-2", "ISO-8859-3", "ISO-8859-4", "ISO-8859-5", "ISO-8859-6",
  "ISO-8859-7", "ISO-8859-8", "ISO-8859-8-I", "ISO-8859-10", "ISO-8859-13", "ISO-8859-14",
  "ISO-8859-15", "ISO-8859-16", "KOI8-R", "KOI8-U", "macintosh", "windows-874", "windows-1250",
  "windows-1251", "windows-1252", "windows-1253", "windows-1254", "windows-1255",
  "windows-1256", "windows-1257", "windows-1258", "x-mac-cyrillic",
]

// Dispatch from WHATWG encoding name to generated tables (codec.mbt).

///|
fn single_byte_tables(encoding : String) -> (Array[Int], Array[Int])? {
  match encoding {
    "IBM866" => Some((ibm866_decode, ibm866_encode))
    "ISO-8859-2" => Some((iso_8859_2_decode, iso_8859_2_encode))
    "ISO-8859-3" => Some((iso_8859_3_decode, iso_8859_3_encode))
    "ISO-8859-4" => Some((iso_8859_4_decode, iso_8859_4_encode))
    "ISO-8859-5" => Some((iso_8859_5_decode, iso_8859_5_encode))
    "ISO-8859-6" => Some((iso_8859_6_decode, iso_8859_6_encode))
    "ISO-8859-7" => Some((iso_8859_7_decode, iso_8859_7_encode))
    "ISO-8859-8" => Some((iso_8859_8_decode, iso_8859_8_encode))
    "ISO-8859-8-I" => Some((iso_8859_8_i_decode, iso_8859_8_i_encode))
    "ISO-8859-10" => Some((iso_8859_10_decode, iso_8859_10_encode))
    "ISO-8859-13" => Some((iso_8859_13_decode, iso_8859_13_encode))
    "ISO-8859-14" => Some((iso_8859_14_decode, iso_8859_14_encode))
    "ISO-8859-15" => Some((iso_8859_15_decode, iso_8859_15_encode))
    "ISO-8859-16" => Some((iso_8859_16_decode, iso_8859_16_encode))
    "KOI8-R" => Some((koi8_r_decode, koi8_r_encode))
    "KOI8-U" => Some((koi8_u_decode, koi8_u_encode))
    "macintosh" => Some((macintosh_decode, macintosh_encode))
    "windows-874" => Some((windows_874_decode, windows_874_encode))
    "windows-1250" => Some((windows_1250_decode, windows_1250_encode))
    "windows-1251" => Some((windows_1251_decode, windows_1251_encode))
    "windows-1252" => Some((windows_1252_decode, windows_1252_encode))
    "windows-1253" => Some((windows_1253_decode, windows_1253_encode))
    "windows-1254" => Some((windows_1254_decode, windows_1254_encode))
    "windows-1255" => Some((windows_1255_decode, windows_1255_encode))
    "windows-1256" => Some((windows_1256_decode, windows_1256_encode))
    "windows-1257" => Some((windows_1257_decode, windows_1257_encode))
    "windows-1258" => Some((windows_1258_decode, windows_1258_encode))
    "x-mac-cyrillic" => Some((x_mac_cyrillic_decode, x_mac_cyrillic_encode))
    _ => None
  }
}

///|
test "python differential: gb18030 encode vs CPython gb18030 (generated)" {
  let vectors : Array[(String, Array[Int])] = [
    ("\u{0000}", [0x00]),
    ("\u{0001}", [0x01]),
    ("\u{0002}", [0x02]),

        0x96, 0x9A, 0xCF, 0xC1, 0xA2, 0xAA, 0xDF, 0xFE, 0x28, 0xEF, 0x4D, 0x77, 0x50,
        0xC3, 0xD4, 0xE7, 0x81,
      ],
      "v;Ú‚q∑g?‚`…º¯ñöœ¡¢™ﬂ˛(ÔMwP√‘ÁÅ",
    ),
  ]
  let label = "macintosh"
  for i in 0..<vectors.length() {

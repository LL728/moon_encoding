// EUC-JP: CPython-error skips=195, spec/CPython divergent=57

///|
test "python differential: EUC-JP decode vs CPython euc_jp (generated)" {
  let vectors : Array[(Array[Int], String)] = [
    ([0x00], "\u{0000}"),
    ([0x01], "\u{0001}"),
    ([0x02], "\u{0002}"),
    ([0x03], "\u{0003}"),
    ([0x04], "\u{0004}"),
    ([0x05], "\u{0005}"),

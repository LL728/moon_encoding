// Generated by tools/gen_vectors.py — DO NOT EDIT.
//
// Oracle: CPython's codecs (an independent implementation of the same code
// pages). Regenerate with:
//     python tools/gen_vectors.py && moon fmt
//
// Bytes CPython cannot serve as an oracle for are excluded per encoding
// (listed below) and covered elsewhere:
//   * both-error bytes  -> our U+FFFD replacement path (hand-written test
//                          driven by the generated tables),
//   * divergent bytes   -> hand-written tests against the vendored spec
//                          table (e.g. the windows-1252 C1 controls).

// Per-encoding oracle coverage (clean / both-error / divergent high bytes):
//   IBM866           clean=128 both-error=  0 divergent=  0
//   ISO-8859-2       clean=128 both-error=  0 divergent=  0
//   ISO-8859-3       clean=121 both-error=  7 divergent=  0
//   ISO-8859-4       clean=128 both-error=  0 divergent=  0
//   ISO-8859-5       clean=128 both-error=  0 divergent=  0
//   ISO-8859-6       clean= 83 both-error= 45 divergent=  0
//   ISO-8859-7       clean=125 both-error=  3 divergent=  0
//   ISO-8859-8       clean= 92 both-error= 36 divergent=  0
//   ISO-8859-8-I     clean= 92 both-error= 36 divergent=  0
//   ISO-8859-10      clean=128 both-error=  0 divergent=  0
//   ISO-8859-13      clean=128 both-error=  0 divergent=  0
//   ISO-8859-14      clean=128 both-error=  0 divergent=  0
//   ISO-8859-15      clean=128 both-error=  0 divergent=  0
//   ISO-8859-16      clean=128 both-error=  0 divergent=  0
//   KOI8-R           clean=128 both-error=  0 divergent=  0
//   KOI8-U           clean=126 both-error=  0 divergent=  2
//   macintosh        clean=128 both-error=  0 divergent=  0
//   windows-874      clean= 97 both-error=  8 divergent= 23
//   windows-1250     clean=123 both-error=  0 divergent=  5
//   windows-1251     clean=127 both-error=  0 divergent=  1
//   windows-1252     clean=123 both-error=  0 divergent=  5
//   windows-1253     clean=111 both-error=  3 divergent= 14
//   windows-1254     clean=121 both-error=  0 divergent=  7
//   windows-1255     clean=105 both-error= 10 divergent= 13
//   windows-1256     clean=128 both-error=  0 divergent=  0
//   windows-1257     clean=116 both-error=  2 divergent= 10
//   windows-1258     clean=119 both-error=  0 divergent=  9
//   x-mac-cyrillic   clean=128 both-error=  0 divergent=  0

///|
test "python differential: ASCII printable identity via three encodings (generated)" {
  let vectors : Array[(Array[Int], String)] = [
    ([0x20], " "),
    ([0x21], "!"),
    ([0x22], "\""),
    ([0x23], "#"),
    ([0x24], "$"),
    ([0x25], "%"),
    ([0x26], "&"),
    ([0x27], "'"),
    ([0x28], "("),
    ([0x29], ")"),
    ([0x2A], "*"),
    ([0x2B], "+"),
    ([0x2C], ","),
    ([0x2D], "-"),
    ([0x2E], "."),
    ([0x2F], "/"),
    ([0x30], "0"),
    ([0x31], "1"),
    ([0x32], "2"),
    ([0x33], "3"),
    ([0x34], "4"),
    ([0x35], "5"),
    ([0x36], "6"),
    ([0x37], "7"),
    ([0x38], "8"),
    ([0x39], "9"),
    ([0x3A], ":"),
    ([0x3B], ";"),
    ([0x3C], "<"),
    ([0x3D], "="),
    ([0x3E], ">"),
    ([0x3F], "?"),
    ([0x40], "@"),
    ([0x41], "A"),
    ([0x42], "B"),
    ([0x43], "C"),
    ([0x44], "D"),
    ([0x45], "E"),
    ([0x46], "F"),
    ([0x47], "G"),
    ([0x48], "H"),
    ([0x49], "I"),
    ([0x4A], "J"),
    ([0x4B], "K"),
    ([0x4C], "L"),
    ([0x4D], "M"),
    ([0x4E], "N"),
    ([0x4F], "O"),
    ([0x50], "P"),
    ([0x51], "Q"),
    ([0x52], "R"),
    ([0x53], "S"),
    ([0x54], "T"),
    ([0x55], "U"),
    ([0x56], "V"),
    ([0x57], "W"),
    ([0x58], "X"),
    ([0x59], "Y"),
    ([0x5A], "Z"),
    ([0x5B], "["),
    ([0x5C], "\\"),
    ([0x5D], "]"),
    ([0x5E], "^"),
    ([0x5F], "_"),
    ([0x60], "`"),
    ([0x61], "a"),
    ([0x62], "b"),
    ([0x63], "c"),
    ([0x64], "d"),
    ([0x65], "e"),
    ([0x66], "f"),
    ([0x67], "g"),
    ([0x68], "h"),
    ([0x69], "i"),
    ([0x6A], "j"),
    ([0x6B], "k"),
    ([0x6C], "l"),
    ([0x6D], "m"),
    ([0x6E], "n"),
    ([0x6F], "o"),
    ([0x70], "p"),
    ([0x71], "q"),
    ([0x72], "r"),
    ([0x73], "s"),
    ([0x74], "t"),
    ([0x75], "u"),
    ([0x76], "v"),
    ([0x77], "w"),
    ([0x78], "x"),
    ([0x79], "y"),
    ([0x7A], "z"),
    ([0x7B], "{"),
    ([0x7C], "|"),
    ([0x7D], "}"),
    ([0x7E], "~"),
  ]
  for i in 0..<vectors.length() {
    let (input, expect) = vectors[i]
    let bytes = bytes_of_ints(input)
    @test.assert_eq(decode(bytes, "windows-1252"), Ok(expect))
    @test.assert_eq(decode(bytes, "iso-8859-2"), Ok(expect))
    @test.assert_eq(decode(bytes, "koi8-r"), Ok(expect))
  }
}


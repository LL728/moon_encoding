    ("\u{000B}", [0x0B]),
    ("\u{000C}", [0x0C]),
    ("\u{000D}", [0x0D]),
    ("\u{000E}", [0x0E]),
    ("\u{000F}", [0x0F]),
    ("\u{0010}", [0x10]),
    ("\u{0011}", [0x11]),
    ("\u{0012}", [0x12]),
    ("\u{0013}", [0x13]),
    ("\u{0014}", [0x14]),
    ("\u{0015}", [0x15]),

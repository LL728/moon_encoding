test "python differential: IBM866 encode vs CPython cp866 (generated)" {
  let vectors : Array[(String, Array[Int])] = [
    (
      "Э{9▒уБ╣p╖!'╪XШ╓",
      [
        0x9D, 0x7B, 0x39, 0xB1, 0xE3, 0x81, 0xB9, 0x70, 0xB7, 0x21, 0x27, 0xD8, 0x58,
        0x98, 0xD6,
      ],
    ),
    (
      "Ж[█Е╓▌LIt",
      [0x86, 0x5B, 0xDB, 0x85, 0xD6, 0xDD, 0x4C, 0x49, 0x74],
    ),
    ("х?Jц&Cоы├", [0xE5, 0x3F, 0x4A, 0xE6, 0x26, 0x43, 0xAE, 0xEB, 0xC3]),
    (
      "№╬4Г:дяL├▒з┼",
      [0xFC, 0xCE, 0x34, 0x83, 0x3A, 0xA4, 0xEF, 0x4C, 0xC3, 0xB1, 0xA7, 0xC5],
    ),
    (
      "ь├ут┤Oїц╙Ъ¤z[P:J(ЕWv╩еЕ3",
      [
        0xEC, 0xC3, 0xE3, 0xE2, 0xB4, 0x4F, 0xF5, 0xE6, 0xD3, 0x9A, 0xFD, 0x7A, 0x5B,
        0x50, 0x3A, 0x4A, 0x28, 0x85, 0x57, 0x76, 0xCA, 0xA5, 0x85, 0x33,
      ],
    ),

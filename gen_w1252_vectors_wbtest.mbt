///|
test "python differential: Shift_JIS encode vs CPython shift_jis (generated)" {
  let vectors : Array[(String, Array[Int])] = [
    ("\u{0000}", [0x00]),
    ("\u{0001}", [0x01]),
    ("\u{0002}", [0x02]),
    ("\u{0003}", [0x03]),
    ("\u{0004}", [0x04]),
    ("\u{0005}", [0x05]),
    ("\u{0006}", [0x06]),
    ("\u{0007}", [0x07]),
    ("\u{0008}", [0x08]),
    ("\u{0009}", [0x09]),
    ("\u{000A}", [0x0A]),
    ("\u{000B}", [0x0B]),
    ("\u{000C}", [0x0C]),
    ("\u{000D}", [0x0D]),
    ("\u{000E}", [0x0E]),
    ("\u{000F}", [0x0F]),
    ("\u{0010}", [0x10]),

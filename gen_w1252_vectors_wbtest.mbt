    ("慄U<iS.z'", [0x90, 0xFC, 0x55, 0x3C, 0x69, 0x53, 0x2E, 0x7A, 0x27]),
    (
      "䲣\u{0011}謉\u{0001}¤n\\𶪲\u{0005}U",
      [
        0xFE, 0x92, 0x11, 0xD6, 0x64, 0x01, 0xA1, 0xE8, 0x6E, 0x5C, 0x9C, 0x35, 0xD9,
        0x36, 0x05, 0x55,
      ],
    ),
    (
      "拡NAjeg\u{001E}XGY𶪲",
      [
        0x92, 0x88, 0x4E, 0x41, 0x6A, 0x65, 0x67, 0x1E, 0x58, 0x47, 0x59, 0x9C, 0x35,
        0xD9, 0x36,
      ],
    ),
    (
      "tz\u{0010}Ro󘖸SXv\u{0017}`\u{001E}¤",
      [
        0x74, 0x7A, 0xA1, 0x75, 0x10, 0xA1, 0x79, 0x52, 0x6F, 0xD1, 0x31, 0xA9, 0x34,
        0x53, 0x58, 0x76, 0x17, 0x60, 0x1E, 0xA1, 0xE8,
      ],
    ),
  ]
  let label = "gb18030"
  for i in 0..<vectors.length() {
    let (text, expect) = vectors[i]
    @test.assert_eq(encode(text, label), Ok(bytes_of_ints(expect)))
  }
}

